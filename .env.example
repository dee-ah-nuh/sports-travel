# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://sports_travel:dev_password_change_in_prod@localhost:5432/sports_travel_dev
POSTGRES_USER=sports_travel
POSTGRES_PASSWORD=dev_password_change_in_prod
POSTGRES_DB=sports_travel_dev
POSTGRES_PORT=5432

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://:dev_redis_password@localhost:6379
REDIS_PASSWORD=dev_redis_password
REDIS_PORT=6379

# ─── API Server ───────────────────────────────────────────────────────────────
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ─── Mock Mode ───────────────────────────────────────────────────────────────
# Set to true to use mock data without real API keys
USE_MOCK_DATA=true

# ─── Supabase Auth (optional for dev) ────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Flight APIs ──────────────────────────────────────────────────────────────
# Amadeus — https://developers.amadeus.com
AMADEUS_API_KEY=your-amadeus-key
AMADEUS_API_SECRET=your-amadeus-secret
AMADEUS_ENV=test

# ─── Sports Data ──────────────────────────────────────────────────────────────
# API-Sports — https://api-sports.io
API_SPORTS_KEY=your-api-sports-key

# ─── Ticket Marketplace ───────────────────────────────────────────────────────
# StubHub Catalog API — https://developer.stubhub.com
STUBHUB_CLIENT_ID=your-stubhub-client-id
STUBHUB_CLIENT_SECRET=your-stubhub-client-secret

# ─── Maps ────────────────────────────────────────────────────────────────────
# Mapbox — https://account.mapbox.com
MAPBOX_SECRET_TOKEN=sk.your-mapbox-secret-token

# Web (Vite public env — prefix with VITE_)
VITE_MAPBOX_TOKEN=pk.your-mapbox-public-token
VITE_API_BASE_URL=http://localhost:3001
