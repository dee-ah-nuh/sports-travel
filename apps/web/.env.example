# Mapbox token for the interactive map
VITE_MAPBOX_TOKEN=your_mapbox_token_here

# Sports Travel Flight API (apps/fli)
# Run locally: cd apps/fli && uv run python sports_travel_server.py
# Then set this to enable live Google Flights data (falls back to mock if unset)
VITE_FLIGHT_API_URL=http://localhost:8001

# Production: set to your Railway deployment URL
# VITE_FLIGHT_API_URL=https://your-fli-service.railway.app
